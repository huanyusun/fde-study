n status = 'paid' and paid_cents - refund_cents > 0 then quantity else 0 end"}]}}]}, {"name": "members", "source": "\"data\".\"main\".\"members\"", "primary_key": ["member_id"], "description": "\u4f1a\u5458\u8d26\u6237\u8868\uff0c\u4e00\u884c\u4e00\u4e2a CRM \u8d26\u6237\u3002", "fields": [{"name": "member", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "member_id"}]}}, {"name": "home_store", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "home_store_id"}]}}, {"name": "registered_at", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "registered_at"}]}, "dimension": {"is_time": true}}, {"name": "tier", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "tier"}]}, "dimension": {"is_time": false}}, {"name": "new_member_count_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "CASE WHEN member_id IS NOT NULL THEN 1 ELSE 0 END"}]}}]}, {"name": "stores_selling", "source": "\"data\".\"main\".\"stores\"", "primary_key": ["store_id"], "description": "\u95e8\u5e97\u8868\uff0c\u6210\u4ea4\u95e8\u5e97\u89d2\u8272\u3002", "fields": [{"name": "store", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "store_id"}]}}, {"name": "region", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "region"}]}, "dimension": {"is_time": false}}, {"name": "store_name", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "store_name"}]}, "dimension": {"is_time": false}}]}, {"name": "stores_home", "source": "\"data\".\"main\".\"stores\"", "primary_key": ["store_id"], "description": "\u95e8\u5e97\u8868\uff0c\u4f1a\u5458\u5f52\u5c5e\u95e8\u5e97\u89d2\u8272\u3002", "fields": [{"name": "home_store", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "store_id"}]}}, {"name": "region", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "region"}]}, "dimension": {"is_time": false}}, {"name": "store_name", "expression": {"dialects": [{"d