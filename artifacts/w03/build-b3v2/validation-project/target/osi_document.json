id"}]}}, {"name": "first_ordered_at", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "first_ordered_at"}]}, "dimension": {"is_time": true}}, {"name": "first_buyer_count_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "CASE WHEN member_id IS NOT NULL THEN 1 ELSE 0 END"}]}}, {"name": "first_order_count_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "CASE WHEN member_id IS NOT NULL THEN 1 ELSE 0 END"}]}}, {"name": "first_order_sales_cents_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "first_net_cents"}]}}]}], "relationships": [{"name": "orders__members__member", "from": "orders", "to": "members", "from_columns": ["member_id"], "to_columns": ["member_id"]}, {"name": "cards__orders__member", "from": "cards", "to": "orders", "from_columns": ["member_id"], "to_columns": ["member_id"]}, {"name": "cards__members__member", "from": "cards", "to": "members", "from_columns": ["member_id"], "to_columns": ["member_id"]}, {"name": "orders__stores_selling__store", "from": "orders", "to": "stores_selling", "from_columns": ["store_id"], "to_columns": ["store_id"]}, {"name": "members__stores_home__home_store", "from": "members", "to": "stores_home", "from_columns": ["home_store_id"], "to_columns": ["store_id"]}], "metrics": [{"name": "first_buyer_count", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(CASE WHEN member_first_valid_order.member_id IS NOT NULL THEN 1 ELSE 0 END)"}]}, "description": "\u5728\u6d4b\u8bd5\u8986\u76d6\u671f\u5185\u9996\u6b21\u6709\u6548\u8ba2\u5355\u843d\u5165\u67e5\u8be2\u7a97\u53e3\u7684\u4e0d\u540c CRM \u8d26\u6237\u6570\uff1b\u4e0d\u4ee3\u8868\u7ec8\u8eab\u9996\u8d2d\u3002\u5148\u7528\u5168\u8986\u76d6\u5386\u53f2\u786e\u5b9a\u9996\u6b21\uff0c\u518d\u6309\u7a97\u53e3\u7b5b\u9009\u3002"}, {"name": "first_order_sales_cents", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(member_first_valid_order.first_net_cents)"}]}, "description": "\u6bcf\u4e2a\u8d26\u6237\u5728\u6d4b\u8bd5\u8986\u76d6\u671f\u5185\u7b2c\u4e00\u7b14\u6709\u6548\u8ba2\u5355\u7684\u51c0\u9500\u552e\u989d\uff0c\u6309\u8be5\u5355\u65e5\u671f\u5f52\u5c5e\uff1b\u76f8\u540c\u65e5\u671f\u6309\u8ba2\u5355\u53f7\u6392\u5e8f\uff1b\u5355\u4f4d\u5206\u3002"}, {"name": "first_order_count", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(CASE WHEN member_first_valid_order.member_id IS NOT NULL THEN 1 ELSE 0 END)"}]}, "description": "\u5728\u5168\u6d4b\u8bd5\u8986\u76d6\u671f\u5185\u5148\u4e3a\u6bcf\u4e2a\u8d26\u6237\u6309\u65e5\u671f\u3001\u8ba2\u5355\u53f7\u6392\u5e8f\uff0c\u5176\u7b2c\u4e00\u7b14\u6709\u6548\u8ba2\u5355\u843d\u5165\u7a97\u53e3\u7684\u5355\u6570\u3002"}, {"name": "repeat_order_count", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(CASE WHEN case when first_seq > 1 then order_id end IS NOT NULL THEN 1 ELSE 0 END)"}]}, "description": "\u8d26\u6237\u5168\u6d4b\u8bd5\u8986\u76d6\u671f\u5185\u7b2c\u4e8c\u7b14\u53ca\u4ee5\u540e\u7684\u6709\u6548\u8ba2\u5355\uff0c\u6309\u8ba2\u5355\u65e5\u671f\u843d\u5165\u7a97\u53e3\u8ba1\u6570\u3002\u4e0d\u662f\u6708\u5185\u590d\u8d2d\u4eba\u6570\u3002"}]}]}