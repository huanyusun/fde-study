{"version": "0.1.1", "dialects": ["ANSI_SQL"], "semantic_model": [{"name": "semantic_model", "datasets": [{"name": "orders", "source": "\"data\".\"main\".\"orders\"", "primary_key": ["order_id"], "fields": [{"name": "order", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "order_id"}]}}, {"name": "member", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "member_id"}]}}, {"name": "store", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "store_id"}]}}, {"name": "ordered_at", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "ordered_at"}]}, "dimension": {"is_time": true}}, {"name": "status", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "status"}]}, "dimension": {"is_time": false}}, {"name": "channel", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "channel"}]}, "dimension": {"is_time": false}}, {"name": "order_created_count", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "CASE WHEN order_id IS NOT NULL THEN 1 ELSE 0 END"}]}}, {"name": "paid_order_count_m", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "case when status = 'paid' then 1 else 0 end"}]}}, {"name": "payment_cents_m", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "case when status = 'paid' then paid_cents else 0 end"}]}}]}], "metrics": [{"name": "order_count", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(CASE WHEN orders.order_id IS NOT NULL THEN 1 ELSE 0 END)"}]}, "description": "\u6309\u4e0b\u5355\u65e5\u671f\u7edf\u8ba1\u5168\u90e8\u8ba2\u5355\uff0c\u6bcf\u4e2a\u8ba2\u5355\u53f7\u4e00\u6b21\uff0c\u5305\u542b\u53d6\u6d88\u5355\u3002"}, {"name": "paid_order_count", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(case when status = 'paid' then 1 else 0 end)"}]}, "description": "\u72b6\u6001\u4e3a paid \u7684\u8ba2\u5355\u6570\uff0c\u5305\u62ec\u540e\u6765\u5168\u90e8\u9000\u6b3e\u7684\u8ba2\u