{
  "semantic_models": [
    {
      "name": "orders",
      "model": "ref('orders')",
      "description": "订单表，一行一笔订单。",
      "defaults": {
        "agg_time_dimension": "ordered_at"
      },
      "entities": [
        {
          "name": "order",
          "type": "primary",
          "expr": "order_id"
        },
        {
          "name": "member",
          "type": "foreign",
          "expr": "member_id"
        },
        {
          "name": "store",
          "type": "foreign",
          "expr": "store_id"
        }
      ],
      "dimensions": [
        {
          "name": "ordered_at",
          "type": "time",
          "type_params": {
            "time_granularity": "day"
          }
        },
        {
          "name": "status",
          "type": "categorical"
        },
        {
          "name": "channel",
          "type": "categorical"
        }
      ],
      "measures": [
        {
          "name": "order_count_measure",
          "expr": "order_id",
          "agg": "count"
        },
        {
          "name": "paid_order_count_measure",
          "expr": "case when status = 'paid' then order_id end",
          "agg": "count"
        },
        {
          "name": "valid_order_count_measure",
          "expr": "case when status = 'paid' and paid_cents - refund_cents > 0 then order_id end",
          "agg": "count"
        },
        {
          "name": "cancelled_order_count_measure",
          "expr": "case when status = 'cancelled' then order_id end",
          "agg": "count"
        },
        {
          "name": "refund_order_count_measure",
          "expr": "case when status = 'paid' and refund_cents > 0 then order_id end",
          "agg": "count"
        },
        {
          "name": "partial_refund_order_count_measure",
          "expr": "case when status = 'paid' and refund_cents > 0 and refund_cents < paid_cents then order_id end",
          "agg": "count"
        },
        {
          "name": "full_refund_order_count_measure",
          "expr": "case when status = 'paid' and paid_cents > 0 and refund_cents = paid_cents then order_id end",
          "agg": "count"
        },
        {
          "name": "payment_cents_measure",
          "expr": "case when status = 'paid' then paid_cents else 0 end",
          "agg": "sum"
        },
        {
          "name": "refund_cents_measure",
          "expr": "case when status = 'paid' then refund_cents else 0 end",
          "agg": "sum"
        },
        {
          "name": "net_sales_cents_measure",
          "expr": "case when status = 'paid' then paid_cents - refund_cents else 0 end",
          "agg": "sum"
        },
        {
          "name": "gross_cents_measure",
          "expr": "case when status = 'paid' then gross_cents else 0 end",
          "agg": "sum"
        },
        {
          "name": "discount_cents_measure",
          "expr": "case when status = 'paid' then gross_cents - paid_cents else 0 end",
          "agg": "sum"
        },
        {
          "name": "buyer_count_measure",
          "expr": "case when status = 'paid' and paid_cents - refund_cents > 0 then member_id end",
          "agg": "count_distinct"
        },
        {
          "name": "refund_buyer_count_measure",
          "expr": "case when status = 'paid' and refund_cents > 0 then member_id end",
          "agg": "count_distinct"
        },
        {
          "name": "selling_store_count_measure",
          "expr": "case when status = 'paid' and paid_cents - refund_cents > 0 then store_id end",
          "agg": "count_distinct"
        },
        {
          "name": "valid_order_items_measure",
          "expr": "case when status = 'paid' and paid_cents - refund_cents > 0 then quantity else 0 end",
          "agg": "sum"
        }
      ]
    },
    {
      "name": "members",
      "model": "ref('members')",
      "description": "会员账户表，一行一个 CRM 账户。",
      "defaults": {
        "agg_time_dimension": "registered_at"
      },
      "entities": [
        {
          "name": "member",
          "type": "primary",
          "expr": "member_id"
        },
        {
          "name": "home_store",
          "type": "foreign",
          "expr": "home_store_id"
        }
      ],
      "dimensions": [
        {
          "name": "registered_at",
          "type": "time",
          "type_params": {
            "time_granularity": "day"
          }
        },
        {
          "name": "tier",
          "type": "categorical"
        }
      ],
      "measures": [
        {
          "name": "new_member_count_measure",
          "expr": "member_id",
          "agg": "count"
        }
      ]
    },
    {
      "name": "stores_selling",
      "model": "ref('stores')",
      "description": "门店表，成交门店角色。",
      "entities": [
        {
          "name": "store",
          "type": "primary",
          "expr": "store_id"
        }
      ],
      "dimensions": [
        {
          "name": "region",
          "type": "categorical"
        },
        {
          "name": "store_name",
          "type": "categorical"
        }
      ],
      "measures": []
    },
    {
      "name": "stores_home",
      "model": "ref('stores')",
      "description": "门店表，会员归属门店角色。",
      "entities": [
        {
          "name": "home_store",
          "type": "primary",
          "expr": "store_id"
        }
      ],
      "dimensions": [
        {
          "name": "region",
          "type": "categorical"
        },
        {
          "name": "store_name",
          "type": "categorical"
        }
      ],
      "measures": []
    },
    {
      "name": "cards",
      "model": "ref('cards')",
      "description": "会员卡表，一行一张卡。",
      "defaults": {
        "agg_time_dimension": "valid_from"
      },
      "entities": [
        {
          "name": "card",
          "type": "primary",
          "expr": "card_id"
        },
        {
          "name": "member",
          "type": "foreign",
          "expr": "member_id"
        }
      ],
      "dimensions": [
        {
          "name": "valid_from",
          "type": "time",
          "type_params": {
            "time_granularity": "day"
          }
        },
        {
          "name": "card_type",
          "type": "categorical"
        }
      ],
      "measures": []
    }
  ],
  "metrics": [
    {
      "name": "order_count",
      "label": "创建订单数",
      "description": "按下单日期统计全部订单，每个订单号一次，包含取消单。",
      "type": "simple",
      "type_params": {
        "measure": "order_count_measure"
      }
    },
    {
      "name": "paid_order_count",
      "label": "支付订单数",
      "description": "状态为 paid 的订单数，包括后来全部退款的订单。",
      "type": "simple",
      "type_params": {
        "measure": "paid_order_count_measure"
      }
    },
    {
      "name": "valid_order_count",
      "label": "有效订单数",
      "description": "状态为 paid 且实付金额减退款金额大于零的订单数；取消和全退不计。",
      "type": "simple",
      "type_params": {
        "measure": "valid_order_count_measure"
      }
    },
    {
      "name": "cancelled_order_count",
      "label": "取消订单数",
      "description": "状态为 cancelled 的订单数。",
      "type": "simple",
      "type_params": {
        "measure": "cancelled_order_count_measure"
      }
    },
    {
      "name": "refund_order_count",
      "label": "退款订单数",
      "description": "paid 状态且退款金额大于零的订单数，包括部分退款与全部退款。",
      "type": "simple",
      "type_params": {
        "measure": "refund_order_count_measure"
      }
    },
    {
      "name": "partial_refund_order_count",
      "label": "部分退款订单数",
      "description": "paid 状态且退款大于零、小于实付金额的订单数。",
      "type": "simple",
      "type_params": {
        "measure": "partial_refund_order_count_measure"
      }
    },
    {
      "name": "full_refund_order_count",
      "label": "全额退款订单数",
      "description": "paid 状态且实付大于零、退款等于实付的订单数。",
      "type": "simple",
      "type_params": {
        "measure": "full_refund_order_count_measure"
      }
    },
    {
      "name": "payment_cents",
      "label": "实付金额",
      "description": "paid 订单实付金额合计，尚未扣退款；单位分。",
      "type": "simple",
      "type_params": {
        "measure": "payment_cents_measure"
      }
    },
    {
      "name": "refund_cents",
      "label": "退款金额",
      "description": "paid 订单退款金额合计，按原订单下单日期归属，不是现金退款发生日；单位分。",
      "type": "simple",
      "type_params": {
        "measure": "refund_cents_measure"
      }
    },
    {
      "name": "net_sales_cents",
      "label": "净销售额",
      "description": "paid 订单实付减退款后合计；取消单不计；按原订单下单日期归属；单位分。",
      "type": "simple",
      "type_params": {
        "measure": "net_sales_cents_measure"
      }
    },
    {
      "name": "gross_cents",
      "label": "支付订单原价金额",
      "description": "paid 订单折扣前原价金额合计；单位分。",
      "type": "simple",
      "type_params": {
        "measure": "gross_cents_measure"
      }
    },
    {
      "name": "discount_cents",
      "label": "优惠金额",
      "description": "paid 订单原价减实付的金额合计；退款不冲减原优惠金额；单位分。",
      "type": "simple",
      "type_params": {
        "measure": "discount_cents_measure"
      }
    },
    {
      "name": "buyer_count",
      "label": "购买会员数",
      "description": "统计窗口及筛选条件内有有效订单的不同 CRM 会员账户数，不做跨系统自然人去重。",
      "type": "simple",
      "type_params": {
        "measure": "buyer_count_measure"
      }
    },
    {
      "name": "refund_buyer_count",
      "label": "退款会员数",
      "description": "统计窗口内发生退款的 paid 订单关联的不同 CRM 会员账户数。",
      "type": "simple",
      "type_params": {
        "measure": "refund_buyer_count_measure"
      }
    },
    {
      "name": "selling_store_count",
      "label": "成交门店数",
      "description": "窗口内至少有一笔有效订单的不同订单归属门店数。",
      "type": "simple",
      "type_params": {
        "measure": "selling_store_count_measure"
      }
    },
    {
      "name": "valid_order_items",
      "label": "有效订单商品件数",
      "description": "有效订单中的原始购买件数合计；退款金额不能推算退货件数，此项不是净商品销量。",
      "type": "simple",
      "type_params": {
        "measure": "valid_order_items_measure"
      }
    },
    {
      "name": "new_member_count",
      "label": "注册会员数",
      "description": "按注册日期统计新注册 CRM 账户数；不等于自然人数。",
      "type": "simple",
      "type_params": {
        "measure": "new_member_count_measure"
      }
    },
    {
      "name": "avg_order_value",
      "label": "有效订单均额",
      "description": "净销售额除以有效订单数，单位分／单；分母为零时未定义（输出 null，不用 0 或 nan 承载）。",
      "type": "derived",
      "type_params": {
        "expr": "case when valid_order_count = 0 then null else net_sales_cents / valid_order_count end",
        "metrics": [
          "net_sales_cents",
          "valid_order_count"
        ]
      }
    },
    {
      "name": "avg_buyer_value",
      "label": "购买会员人均消费",
      "description": "净销售额除以购买会员数，单位分／账户；分母为零时未定义（输出 null）。",
      "type": "derived",
      "type_params": {
        "expr": "case when buyer_count = 0 then null else net_sales_cents / buyer_count end",
        "metrics": [
          "net_sales_cents",
          "buyer_count"
        ]
      }
    },
    {
      "name": "purchase_frequency",
      "label": "购买频次",
      "description": "有效订单数除以购买会员数，单位单／账户；分母为零时未定义（输出 null）。",
      "type": "derived",
      "type_params": {
        "expr": "case when buyer_count = 0 then null else valid_order_count / buyer_count end",
        "metrics": [
          "valid_order_count",
          "buyer_count"
        ]
      }
    },
    {
      "name": "refund_amount_rate",
      "label": "退款金额占比",
      "description": "退款金额除以实付金额；分母为零时未定义（输出 null）。",
      "type": "derived",
      "type_params": {
        "expr": "case when payment_cents = 0 then null else refund_cents / payment_cents end",
        "metrics": [
          "refund_cents",
          "payment_cents"
        ]
      }
    },
    {
      "name": "cancel_rate",
      "label": "取消率",
      "description": "取消订单数除以创建订单数；分母为零时未定义（输出 null）。",
      "type": "derived",
      "type_params": {
        "expr": "case when order_count = 0 then null else cancelled_order_count / order_count end",
        "metrics": [
          "cancelled_order_count",
          "order_count"
        ]
      }
    },
    {
      "name": "refund_order_rate",
      "label": "退款订单率",
      "description": "退款订单数除以支付订单数；分母为零时未定义（输出 null）。",
      "type": "derived",
      "type_params": {
        "expr": "case when paid_order_count = 0 then null else refund_order_count / paid_order_count end",
        "metrics": [
          "refund_order_count",
          "paid_order_count"
        ]
      }
    },
    {
      "name": "discount_rate",
      "label": "优惠率",
      "description": "优惠金额除以支付订单原价金额；分母为零时未定义（输出 null）。",
      "type": "derived",
      "type_params": {
        "expr": "case when gross_cents = 0 then null else discount_cents / gross_cents end",
        "metrics": [
          "discount_cents",
          "gross_cents"
        ]
      }
    },
    {
      "name": "items_per_order",
      "label": "单均商品件数",
      "description": "有效订单商品件数除以有效订单数；分母为零时未定义（输出 null）。",
      "type": "derived",
      "type_params": {
        "expr": "case when valid_order_count = 0 then null else valid_order_items / valid_order_count end",
        "metrics": [
          "valid_order_items",
          "valid_order_count"
        ]
      }
    }
  ],
