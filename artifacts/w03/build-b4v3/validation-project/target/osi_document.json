{"version": "0.1.1", "dialects": ["ANSI_SQL"], "semantic_model": [{"name": "semantic_model", "datasets": [{"name": "orders", "source": "\"data\".\"main\".\"orders\"", "primary_key": ["order_id"], "description": "\u8ba2\u5355\u8868\uff0c\u4e00\u884c\u4e00\u7b14\u8ba2\u5355\u3002", "fields": [{"name": "order", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "order_id"}]}}, {"name": "member", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "member_id"}]}}, {"name": "store", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "store_id"}]}}, {"name": "ordered_at", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "ordered_at"}]}, "dimension": {"is_time": true}}, {"name": "status", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "status"}]}, "dimension": {"is_time": false}}, {"name": "channel", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "channel"}]}, "dimension": {"is_time": false}}, {"name": "order_count_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "CASE WHEN order_id IS NOT NULL THEN 1 ELSE 0 END"}]}}, {"name": "paid_order_count_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "CASE WHEN case when status = 'paid' then order_id end IS NOT NULL THEN 1 ELSE 0 END"}]}}, {"name": "valid_order_count_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "CASE WHEN case when status = 'paid' and paid_cents - refund_cents > 0 then order_id end IS NOT NULL THEN 1 ELSE 0 END"}]}}, {"name": "cancelled_order_count_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "CASE WHEN case when status = 'cancelled' then order_id end IS NOT NULL THEN 1 ELSE 0 END"}]}}, {"name": "refund_order_count_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "CASE WHEN case when status = 'paid' and refund_cents > 0 then order_id end IS NOT NULL THEN 1 ELSE 0 END"}]}}, {"name": "partial_refund_order_count_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "CASE WHEN case when status = 'paid' and refund_cents > 0 and refund_cents < paid_cents then order_id end IS NOT NULL THEN 1 ELSE 0 END"}]}}, {"name": "full_refund_order_count_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "CASE WHEN case when status = 'paid' and paid_cents > 0 and refund_cents = paid_cents then order_id end IS NOT NULL THEN 1 ELSE 0 END"}]}}, {"name": "payment_cents_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "case when status = 'paid' then paid_cents else 0 end"}]}}, {"name": "refund_cents_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "case when status = 'paid' then refund_cents else 0 end"}]}}, {"name": "net_sales_cents_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "case when status = 'paid' then paid_cents - refund_cents else 0 end"}]}}, {"name": "gross_cents_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "case when status = 'paid' then gross_cents else 0 end"}]}}, {"name": "discount_cents_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "case when status = 'paid' then gross_cents - paid_cents else 0 end"}]}}, {"name": "buyer_count_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "case when status = 'paid' and paid_cents - refund_cents > 0 then member_id end"}]}}, {"name": "refund_buyer_count_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "case when status = 'paid' and refund_cents > 0 then member_id end"}]}}, {"name": "selling_store_count_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "case when status = 'paid' and paid_cents - refund_cents > 0 then store_id end"}]}}, {"name": "valid_order_items_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "case when status = 'paid' and paid_cents - refund_cents > 0 then quantity else 0 end"}]}}]}, {"name": "members", "source": "\"data\".\"main\".\"members\"", "primary_key": ["member_id"], "description": "\u4f1a\u5458\u8d26\u6237\u8868\uff0c\u4e00\u884c\u4e00\u4e2a CRM \u8d26\u6237\u3002", "fields": [{"name": "member", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "member_id"}]}}, {"name": "home_store", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "home_store_id"}]}}, {"name": "registered_at", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "registered_at"}]}, "dimension": {"is_time": true}}, {"name": "tier", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "tier"}]}, "dimension": {"is_time": false}}, {"name": "new_member_count_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "CASE WHEN member_id IS NOT NULL THEN 1 ELSE 0 END"}]}}]}, {"name": "stores_selling", "source": "\"data\".\"main\".\"stores\"", "primary_key": ["store_id"], "description": "\u95e8\u5e97\u8868\uff0c\u6210\u4ea4\u95e8\u5e97\u89d2\u8272\u3002", "fields": [{"name": "store", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "store_id"}]}}, {"name": "region", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "region"}]}, "dimension": {"is_time": false}}, {"name": "store_name", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "store_name"}]}, "dimension": {"is_time": false}}]}, {"name": "stores_home", "source": "\"data\".\"main\".\"stores\"", "primary_key": ["store_id"], "description": "\u95e8\u5e97\u8868\uff0c\u4f1a\u5458\u5f52\u5c5e\u95e8\u5e97\u89d2\u8272\u3002", "fields": [{"name": "home_store", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "store_id"}]}}, {"name": "region", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "region"}]}, "dimension": {"is_time": false}}, {"name": "store_name", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "store_name"}]}, "dimension": {"is_time": false}}]}, {"name": "cards", "source": "\"data\".\"main\".\"cards\"", "primary_key": ["card_id"], "description": "\u4f1a\u5458\u5361\u8868\uff0c\u4e00\u884c\u4e00\u5f20\u5361\u3002", "fields": [{"name": "card", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "card_id"}]}}, {"name": "member", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "member_id"}]}}, {"name": "valid_from", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "valid_from"}]}, "dimension": {"is_time": true}}, {"name": "card_type", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "card_type"}]}, "dimension": {"is_time": false}}]}, {"name": "account_month_general", "source": "\"data\".\"main\".\"account_month_general\"", "primary_key": ["account_month_key"], "description": "\u8d26\u6237\u6708\u5ea6\u6709\u6548\u8ba2\u5355\u8868\uff0c\u4e00\u884c\u4e00\u4e2a\u8d26\u6237\u4e00\u4e2a\u81ea\u7136\u6708\uff0caccount_month_key \u4e3a\u8d26\u6237\u4e0e\u6708\u8d77\u70b9\u62fc\u63a5\u7684\u4ee3\u7406\u952e\u3002", "fields": [{"name": "account_month", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "account_month_key"}]}}, {"name": "month_start", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "month_start"}]}, "dimension": {"is_time": true}}, {"name": "member_id", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "member_id"}]}, "dimension": {"is_time": false}}, {"name": "monthly_buyer_count_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "CASE WHEN member_id IS NOT NULL THEN 1 ELSE 0 END"}]}}, {"name": "monthly_repeat_buyer_count_measure", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "CASE WHEN case when valid_order_cnt >= 2 then member_id end IS NOT NULL THEN 1 ELSE 0 END"}]}}]}], "relationships": [{"name": "orders__members__member", "from": "orders", "to": "members", "from_columns": ["member_id"], "to_columns": ["member_id"]}, {"name": "cards__orders__member", "from": "cards", "to": "orders", "from_columns": ["member_id"], "to_columns": ["member_id"]}, {"name": "cards__members__member", "from": "cards", "to": "members", "from_columns": ["member_id"], "to_columns": ["member_id"]}, {"name": "orders__stores_selling__store", "from": "orders", "to": "stores_selling", "from_columns": ["store_id"], "to_columns": ["store_id"]}, {"name": "members__stores_home__home_store", "from": "members", "to": "stores_home", "from_columns": ["home_store_id"], "to_columns": ["store_id"]}], "metrics": [{"name": "monthly_buyer_count", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(CASE WHEN account_month_general.member_id IS NOT NULL THEN 1 ELSE 0 END)"}]}, "description": "\u540c\u4e00\u81ea\u7136\u6708\u6709\u81f3\u5c11\u4e00\u7b14\u6709\u6548\u8ba2\u5355\u7684\u8d26\u6237\u6570\uff0c\u4ec5\u6574\u6708\u3001\u5168\u95e8\u5e97\u53e3\u5f84\uff1b\u6309\u8d26\u6237\u53bb\u91cd\uff0c\u591a\u6708\u5206\u522b\u5c55\u793a\u3001\u4e0d\u80fd\u8de8\u6708\u52a0\u603b\u3002"}, {"name": "monthly_repeat_buyer_count", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "SUM(CASE WHEN case when valid_order_cnt >= 2 then member_id end IS NOT NULL THEN 1 ELSE 0 END)"}]}, "description": "\u540c\u4e00\u81ea\u7136\u6708\u6709\u81f3\u5c11\u4e24\u7b14\u6709\u6548\u8ba2\u5355\u7684\u8d26\u6237\u6570\uff0c\u4ec5\u6574\u6708\u3001\u5168\u95e8\u5e97\u53e3\u5f84\u3002"}, {"name": "monthly_repeat_rate", "expression": {"dialects": [{"dialect": "ANSI_SQL", "expression": "case when SUM(CASE WHEN account_month_general.member_id IS NOT NULL THEN 1 ELSE 0 END) = 0 then null else SUM(CASE WHEN case when valid_order_cnt >= 2 then member_id end IS NOT NULL THEN 1 ELSE 0 END) / SUM(CASE WHEN account_month_general.member_id IS NOT NULL THEN 1 ELSE 0 END) end"}]}, "description": "\u540c\u4e00\u81ea\u7136\u6708\u7684\u6708\u5185\u590d\u8d2d\u4f1a\u5458\u6570\u9664\u4ee5\u6708\u5185\u8d2d\u4e70\u4f1a\u5458\u6570\uff0c\u4ec5\u6574\u6708\u3001\u5168\u95e8\u5e97\u53e3\u5f84\uff1b\u5206\u6bcd\u4e3a\u96f6\u65f6\u672a\u5b9a\u4e49\uff0c\u8f93\u51fa null\u3002"}]}]}