{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "w04-0.1.0"
    },
    "data_version": {
      "type": "string",
      "minLength": 1
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "inferred_type": {
            "type": "string",
            "minLength": 1
          },
          "total_count": {
            "type": "integer",
            "minimum": 0
          },
          "missing_count": {
            "type": "integer",
            "minimum": 0
          },
          "distribution": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "value",
                "count"
              ]
            },
            "minItems": 1
          },
          "range": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "min": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "max": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "required": [
              "min",
              "max"
            ]
          }
        },
        "required": [
          "source_file",
          "field",
          "inferred_type",
          "total_count",
          "missing_count"
        ],
        "anyOf": [
          {
            "required": [
              "distribution"
            ]
          },
          {
            "required": [
              "range"
            ]
          }
        ]
      },
      "minItems": 1
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1
              },
              "source_file": {
                "type": "string",
                "minLength": 1
              },
              "sample_rows": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "minItems": 1
              }
            },
            "required": [],
            "anyOf": [
              {
                "required": [
                  "query"
                ]
              },
              {
                "required": [
                  "source_file",
                  "sample_rows"
                ]
              }
            ]
          }
        },
        "required": [
          "pattern",
          "evidence"
        ]
      },
      "minItems": 1
    },
    "dictionary_differences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "dictionary_claim": {
            "type": "string",
            "minLength": 1
          },
          "actual": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_file",
          "field",
          "dictionary_claim",
          "actual",
          "impact"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "contract_version",
    "data_version",
    "fields",
    "anomalies",
    "dictionary_differences"
  ]
}
